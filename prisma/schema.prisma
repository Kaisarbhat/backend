generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String   @unique
  phoneNumber String
  bloodGroup  String
  createdAt   DateTime @default(now())

  Payment Payment?
}

model Event {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String    @unique
  shortName      String
  eventImageUrl  String
  description    String
  date           String
  location       String
  middleImageUrl String
  heading        String
  text           String[]
  bottomImageUrl String
  bottomHeading  String
  bottomText     String
  warning        String
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedBy      String?
  updatedAt      DateTime? @updatedAt
  resultLink     String?
}

