// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String @unique
  phoneNumber String
  bloodGroup  String
}

model Event {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  imageUrl    String
  description String
  date        DateTime
  location    String

  EventData EventData[]
}

model EventData {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl   String
  eventId    String  @db.ObjectId
  event      Event   @relation(fields: [eventId], references: [id])
  details1   String?
  details2   String?
  details3   String?
  details4   String?
  direction1 String?
  direction2 String?
  direction3 String?
  direction4 String?
}

model Admin {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  username String @unique
  password String
}
