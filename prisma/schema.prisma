// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String @unique
  phoneNumber String
  bloodGroup  String
}

model Event {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String     @unique
  shortName   String
  imageUrl    String
  description String
  date        String
  location    String
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedBy   String?
  updatedAt   DateTime?  @updatedAt
  resultLink  String?
  eventData   EventData?
}

model EventData {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  raceImageUrl String
  eventId      String  @unique @db.ObjectId
  event        Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  details1     String
  details2     String?
  details3     String?
  details4     String?
  direction1   String
  direction2   String?
  direction3   String?
  direction4   String?
}

model Admin {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  username  String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model RegistrationData {
  id                       String  @id @default(auto()) @map("_id") @db.ObjectId
  eventId                  String  @db.ObjectId
  runningCategory          String
  firstName                String
  lastName                 String
  mobile                   String
  email                    String  @unique
  gender                   String
  dateOfBirth              String
  tShirtSize               String
  city                     String
  state                    String
  bloodGroup               String
  bibName                  String
  runningClub              String
  emergencyContactName     String
  emergencyContactRelation String
  emergencyContactNumber   String
  cardiovascularDisease    Boolean
  medicalSupervision       Boolean
  pregnancyRisk            Boolean
  asthma                   Boolean
  dizziness                Boolean
  chestPain                Boolean
  chronicIllness           Boolean
  otherMedicalConditions   String?
  timingCertificates       String?
  waiverAcknowledgement    Boolean
  joinClub                 Boolean
}

model OurFeatures {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl    String
  title       String    @unique
  description String
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedBy   String?
  updatedAt   DateTime? @updatedAt
}

model RecentActivities {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl  String    @unique
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime? @updatedAt
}

model AboutUs {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl  String    @unique
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime? @updatedAt
}

model Payment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  createdAt DateTime @default(now())
  amount    String
}
