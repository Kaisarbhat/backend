generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String    @unique
  phoneNumber String
  bloodGroup  String
  terms       Boolean?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
}

model Event {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  name             String     @unique
  shortName        String
  eventBannerOne   String
  eventBannerTwo   String
  eventBannerThree String
  description      String
  date             String
  location         String
  locationUrl      String
  middleImageUrl   String
  heading          String
  text             String[]
  bottomImageUrl   String
  bottomHeading    String
  bottomText       String
  warning          String
  createdBy        String
  createdAt        DateTime   @default(now())
  updatedBy        String?
  updatedAt        DateTime?  @updatedAt
  resultLink       String?
  sponsors         Sponsors[]
}

model Admin {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  username  String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model OurFeatures {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl    String
  title       String    @unique
  description String
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedBy   String?
  updatedAt   DateTime? @updatedAt
}

model RecentActivities {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl  String   @unique
  createdBy String
  createdAt DateTime @default(now())
}

model RecentActivitiesMobile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl  String   @unique
  createdBy String
  createdAt DateTime @default(now())
}

model AboutUs {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl  String   @unique
  createdBy String
  createdAt DateTime @default(now())
}

model AboutUsHeroImage {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl  String    @unique
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime? @updatedAt
}

model HeroImage {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl  String    @unique
  createdBy String
  createdAt DateTime? @default(now())
  updatedBy String?
  updatedAt DateTime? @updatedAt
}

model Sponsors {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl  String
  eventId   String?   @db.ObjectId
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime? @updatedAt
  Event     Event?    @relation(fields: [eventId], references: [id])

  @@unique([imageUrl, eventId])
}

model RegistrationData {
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId                  String   @db.ObjectId
  paymentId                String   @unique @db.ObjectId
  runningCategory          String
  firstName                String
  lastName                 String
  mobile                   String
  email                    String
  gender                   String
  dateOfBirth              String
  tShirtSize               String
  city                     String
  state                    String
  bloodGroup               String
  bibName                  String
  runningClub              String
  emergencyContactName     String
  emergencyContactRelation String
  emergencyContactNumber   String
  cardiovascularDisease    String
  medicalSupervision       String
  pregnancyRisk            String
  asthma                   String
  dizziness                String
  chestPain                String
  chronicIllness           String
  otherMedicalConditions   String?
  timingCertificates       String
  createdAt                DateTime @default(now())
  waiverAcknowledgement    Boolean
  joinClub                 Boolean?

  @@unique([email, eventId])
}

model Payment {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  razorpayPaymentId String         @unique
  amount            Float
  currency          String
  status            String
  method            PaymentMethod?
  email             String
  contact           String
  paymentDetails    Json?
  errorCode         String?
  errorDescription  String?
  orderId           String
  createdAt         DateTime       @default(now())
}

enum PaymentMethod {
  CARD
  NET_BANKING
  WALLET
  UPI
}
