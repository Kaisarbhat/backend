generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String   @unique
  phoneNumber String
  bloodGroup  String
  createdAt   DateTime @default(now())

  orders Orders?
}

model Event {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String    @unique
  shortName        String
  eventBannerOne   String
  eventBannerTwo   String
  eventBannerThree String
  description      String
  date             String
  location         String
  locationUrl      String
  middleImageUrl   String
  heading          String
  text             String[]
  bottomImageUrl   String
  bottomHeading    String
  bottomText       String
  warning          String
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedBy        String?
  updatedAt        DateTime? @updatedAt
  resultLink       String?
}

model Admin {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  username  String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model RegistrationData {
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId                  String   @db.ObjectId
  runningCategory          String
  firstName                String
  lastName                 String
  mobile                   String
  email                    String   @unique
  gender                   String
  dateOfBirth              String
  tShirtSize               String
  city                     String
  state                    String
  bloodGroup               String
  bibName                  String
  runningClub              String
  emergencyContactName     String
  emergencyContactRelation String
  emergencyContactNumber   String
  cardiovascularDisease    String
  medicalSupervision       String
  pregnancyRisk            String
  asthma                   String
  dizziness                String
  chestPain                String
  chronicIllness           String
  otherMedicalConditions   String?
  timingCertificates       String
  createdAt                DateTime @default(now())
  waiverAcknowledgement    Boolean
  joinClub                 Boolean?
}

model OurFeatures {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl    String
  title       String    @unique
  description String
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedBy   String?
  updatedAt   DateTime? @updatedAt
}

model RecentActivities {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl  String   @unique
  createdBy String
  createdAt DateTime @default(now())
}

model AboutUs {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl  String   @unique
  createdBy String
  createdAt DateTime @default(now())
}

model Orders {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  amount    Float
  currency  String
  receipt   String
  status    String
  createdAt DateTime @default(now())
  createdBy User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
